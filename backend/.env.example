# Copiar este archivo como ".env" (en esta misma carpeta) y completar los valores.
# El .env real no se sube a GitHub (está en .gitignore).

# Cadena de conexión de MongoDB Atlas
MONGO_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/<base>

# Puerto local del servidor (en Render no hace falta: lo define Render)
PORT=4000
