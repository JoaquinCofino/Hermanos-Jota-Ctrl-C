# Copiar este archivo como ".env" (en esta misma carpeta) y completar los valores.
# El .env real no se sube a GitHub (está en .gitignore).

# Cadena de conexión de MongoDB Atlas
MONGO_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/<base> aca va la base de datos que se quiere usar
Si quieren hacer cambios en la base de datos para probar, está hermanosjota_db_test

# Puerto local del servidor (en Render no hace falta: lo define Render)
PORT=4000
REACT_APP_API_URL=url de ejemplo para el backend en render

JWT_SECRET=<cadena-aleatoria>
